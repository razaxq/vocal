{
  "name": "vocal",
  "version": "1.0.3",
  "description": "Vocal — C++ / Qt Quick 本地语音输入",
  "private": true,
  "author": {
    "name": "Ramos",
    "url": "https://blog.dtft.net/about/"
  },
  "homepage": "https://blog.dtft.net/about/",
  "repository": {
    "type": "git",
    "url": "https://github.com/razaxq/vocal.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "powershell -NoProfile -ExecutionPolicy Bypass -File native/scripts/dev.ps1 run",
    "build": "powershell -NoProfile -ExecutionPolicy Bypass -File native/scripts/dev.ps1 build",
    "test": "node --test scripts/dictionary/*.test.mjs",
    "test:native": "powershell -NoProfile -ExecutionPolicy Bypass -File native/scripts/dev.ps1 test",
    "sync:rime": "node scripts/sync-rime.mjs"
  }
}
