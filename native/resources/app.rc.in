#include <windows.h>
IDI_ICON1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/../build/icon.ico"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "Ramos\0"
   VALUE "FileDescription", "Vocal\0"
   VALUE "FileVersion", "@VOCAL_APP_VERSION@\0"
   VALUE "ProductName", "Vocal\0"
   VALUE "ProductVersion", "@VOCAL_APP_VERSION@\0"
   VALUE "LegalCopyright", "Copyright 2026 Ramos\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
